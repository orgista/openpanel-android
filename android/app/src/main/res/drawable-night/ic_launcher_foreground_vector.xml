<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Dark-mode quad mark: slate squares on the dark background
         (@color/ic_launcher_background from values-night). Same geometry as
         the light variant in drawable/. -->

    <!-- Top-left square -->
    <path
        android:pathData="M37,31 h10 a6,6 0,0,1 6,6 v10 a6,6 0,0,1 -6,6 h-10 a6,6 0,0,1 -6,-6 v-10 a6,6 0,0,1 6,-6 z"
        android:fillColor="#94A3B8" />

    <!-- Top-right square — blue accent -->
    <path
        android:pathData="M61,31 h10 a6,6 0,0,1 6,6 v10 a6,6 0,0,1 -6,6 h-10 a6,6 0,0,1 -6,-6 v-10 a6,6 0,0,1 6,-6 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="55" android:startY="31"
                android:endX="77" android:endY="53"
                android:type="linear">
                <item android:offset="0" android:color="#FF5BAEE0" />
                <item android:offset="1" android:color="#FF2E7EB8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom-left square -->
    <path
        android:pathData="M37,55 h10 a6,6 0,0,1 6,6 v10 a6,6 0,0,1 -6,6 h-10 a6,6 0,0,1 -6,-6 v-10 a6,6 0,0,1 6,-6 z"
        android:fillColor="#94A3B8" />

    <!-- Bottom-right square -->
    <path
        android:pathData="M61,55 h10 a6,6 0,0,1 6,6 v10 a6,6 0,0,1 -6,6 h-10 a6,6 0,0,1 -6,-6 v-10 a6,6 0,0,1 6,-6 z"
        android:fillColor="#94A3B8" />

</vector>

