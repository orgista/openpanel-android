<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Blank icon, as in values/styles.xml: Android 12+ would otherwise show the
         launcher icon before the in-app wordmark animation. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/openpanel_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/openpanel_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/openpanel_launch_background</item>
    </style>
</resources>
